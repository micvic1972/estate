// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

//talks with the client prisma.js
generator client {
  provider = "prisma-client-js"
  
}
//talsk with the db server
datasource db {
  provider = "mongodb"
  url = env("DATABASE_URL")
}


model User {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  name  String
  email String @unique
  password String
  avatarUrl String?
  isAdmin   Boolean  @default(false) 
  createdAt DateTime @default(now())
  refreshToken String?  
  updatedAt    DateTime @updatedAt
}

model Otp {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   
  code         String   // The hashed 6-digit verification pin code
  purpose      String   // "REGISTER", "FORGOT_PASSWORD", or "RESET"
  requestCount Int      @default(1) // 🚀 Tracks how many codes sent in the last 2 hours
  createdAt    DateTime @default(now())
  expiresAt    DateTime // We will update this to 15 minutes!
  lastRequestAt DateTime @default(now())   
}
